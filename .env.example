# Execute python scripts/configurar_demo.py para gerar um .env local.
# Use as mesmas chaves nas três agências. Nunca versione o .env.
JWT_SECRET=<gere-uma-chave-aleatoria-de-no-minimo-32-caracteres>
AGENCIAS_JWT_SECRET=<gere-outra-chave-aleatoria-distinta>
LOGIN_USUARIO=aluno
LOGIN_SENHA_HASH='<hash-argon2id>'
JWT_TTL_SECONDS=900

# Use a URL amqps:// do CloudAMQP ou a alternativa RabbitMQ local do roteiro.
# Não versione a URL com credenciais reais.
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
